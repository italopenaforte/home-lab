# Identidade do usuário que será dono dos arquivos no host.
# Descubra com: id -u; id -g
PUID=1000
PGID=1000
TZ=America/Sao_Paulo

# Armazenamento. CONFIG_ROOT e DATA_ROOT devem permanecer fora do repositório.
CONFIG_ROOT=/srv/media/config
DATA_ROOT=/srv/media/data

# Descubra com: getent group render; getent group video
RENDER_GID=109
VIDEO_GID=44

# Interfaces web na rede local.
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_TORRENT_PORT=6881
PROWLARR_PORT=9696
RADARR_PORT=7878
SONARR_PORT=8989
JELLYFIN_PORT=8096
HOMEPAGE_PORT=3000

# Use o IP reservado no roteador ou um hostname resolvível na rede local.
HOMEPAGE_SERVER_HOST=media-server.local
HOMEPAGE_ALLOWED_HOSTS=*
