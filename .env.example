# =============================================================================
# Home Lab Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Traefik ---
# Generate with: echo $(htpasswd -nB admin) | sed -e s/\\$/\\$\\$/g
TRAEFIK_DASHBOARD_CREDENTIALS=admin:$$2y$$...

# --- Pi-hole ---
PIHOLE_PASSWORD=changeme

# --- Vaultwarden ---
# Generate with: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=changeme

# --- Speedtest Tracker ---
# Generated automatically on first run, or set manually:
# echo -n 'base64:'; openssl rand -base64 32;
# SPEEDTEST_APP_KEY=base64:...

# --- Cloudflare (for Traefik DNS challenge) ---
# Store the actual token in stacks/traefik/cf_api_token.txt
# CF_DNS_API_TOKEN=your_cloudflare_api_token

# --- Homepage ---
HOMEPAGE_VAR_SERVER_IP=192.168.1.23
